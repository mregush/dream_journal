# Copy to .env.prod on the server, chmod 600 .env.prod, then fill in the empty values.
# A locally built/loaded image or an immutable registry tag, e.g. ghcr.io/owner/dream-journal:COMMIT_SHA.
APP_IMAGE=dream-journal:local
COMPOSE_PROJECT_NAME=dream-journal

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=dream_journal_agent
TELEGRAM_BOT_ENABLED=true
DIARY_DEFAULT_TIME_ZONE=Europe/Moscow

DB_NAME=dream_journal
DB_USERNAME=dream_journal
DB_PASSWORD=
